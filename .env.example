# ---- Kalshi API --------------------------------------------------------------
# prod = the real exchange (real prices; orders are only ever sent when TRADING_MODE=live).
# demo = Kalshi's practice exchange: fake money, but very few markets and usually no tennis.
KALSHI_ENV=prod
# Create an API key at https://kalshi.com/account/profile (or https://demo.kalshi.co for demo). Kalshi
# gives you a key id and downloads an RSA private key (.pem). Never commit the key.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem
# Alternatively paste the PEM text (e.g. for container secrets):
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Bot mode ----------------------------------------------------------------
# tennis = live tennis swing trading (default). general = EV trading on any market.
BOT_MODE=tennis
# Starts OFF. Turn it on with the Resume button on the dashboard once your keys are in.
BOT_ENABLED=false

# ---- Which markets to trade --------------------------------------------------
# Kalshi series the bot scans and may trade (comma separated). Easiest managed from
# the dashboard: press "Scan the exchange" under Markets and switch on what it finds.
# The four below are the ones confirmed against the live exchange - nothing else is
# listed here from memory, because a ticker that does not exist looks exactly like a
# market with nothing trading in it, and the difference is invisible until a whole
# session passes with no trades.
ENABLED_SERIES=KXATPMATCH,KXWTAMATCH,KXATPCHALLENGERMATCH,KXWTACHALLENGERMATCH
# Optional: switch on a whole family by prefix, e.g. KXNFL to take every NFL series.
SERIES_PREFIXES=
# How much of the exchange a discovery scan sweeps. Runs on demand, not on the loop.
DISCOVERY_PAGES=12
DISCOVERY_TTL_MINUTES=60
LIVE_ONLY=true
LIVE_WINDOW_MINUTES=10
# A match counts as live only once this many contracts have actually traded in the
# window. Quotes alone drift hours before play on thin Challenger books.
LIVE_MIN_VOLUME_DELTA=1
SWING_WINDOW_MINUTES=30
# A round trip costs ~3.5c per contract in fees (charged on entry AND exit), so the
# expected gain of half a retrace only survives from about an 8c dip. 14c leaves
# real edge. Dropping this below 10 makes the bot trade more and earn less.
DIP_CENTS=14
# Form scores inform fair value; they no longer veto a trade. Raise them to require
# the open-data form to back a player before the bot will buy the dip.
MIN_FORM_SCORE=0
MIN_COMEBACK_SCORE=0
MIN_PRE_MATCH_P_WIN=0.15
MAX_PRE_MATCH_PRICE_CENTS=85
# Player form from a public tennis results dataset. Free, no API key - but there is
# no default source, so this stays off until FORM_SOURCES names one. Each entry is a
# URL template containing {year}; the CSV needs winner_name, loser_name, tourney_date,
# surface, score, winner_rank_points and loser_rank_points.
FORM_ENABLED=false
FORM_SOURCES=
# Research each match with Claude + web search (needs ANTHROPIC_API_KEY). Off by
# default: it costs money and the bot trades the price action without it.
RESEARCH_ENABLED=false
# No form and no research found? Fall back to the price rules alone.
ALLOW_WITHOUT_RESEARCH=true
# ...and allow those price-only entries to spend REAL money, not just paper. This is
# the aggressive setting: the price rule cannot tell a tactical wobble from an injury,
# so some dips it buys keep falling. Set false (or run the Safe profile) to require
# form or research before any live order.
ALLOW_PRICE_ONLY_LIVE=true
# After closing a position, leave that player alone this long. The dip is measured
# against a rolling high that does not decay, so a player sliding all match reads as a
# fresh dip at every new low - without this the bot buys one decline over and over.
# 180 is longer than a match, so in practice each market is traded once. 0 = off.
REENTRY_COOLDOWN_MINUTES=180
# Off = ride a position to its target or to settlement instead of stopping out. You
# risk the whole stake, but pay no exit fee on losers and are not shaken out by noise.
USE_STOP_LOSS=true
ASSESSMENT_TTL_MINUTES=180
RESEARCH_MAX_SEARCHES=6

# ---- Trading mode ------------------------------------------------------------
# paper = simulated fills against live quotes, no orders sent. live = real orders.
TRADING_MODE=paper
PAPER_STARTING_CASH=1000
PAPER_SLIPPAGE_CENTS=1

# ---- Scan ------------------------------------------------------------------
# Below ~15s Kalshi rate-limits (429) and scans get dropped. 15 is the enforced floor.
SCAN_INTERVAL_SECONDS=60
SCAN_LIMIT=200
MARKET_SCAN_LIMIT=1500
# Restrict to series (comma separated) e.g. KXBTC,KXHIGHNY ; empty = all open markets
SERIES_TICKERS=
EVENT_TICKERS=
MIN_HOURS_TO_CLOSE=0.5
MAX_HOURS_TO_CLOSE=336
MIN_VOLUME_24H=50

# ---- Edge / EV (cents per contract) ------------------------------------------
MIN_EDGE_CENTS=3.5
MIN_CONFIDENCE=0.5
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95
FEE_RATE=0.07

# ---- Liquidity ---------------------------------------------------------------
MAX_SPREAD_CENTS=5
REJECT_WIDE_SPREAD=true
MIN_DEPTH_CONTRACTS=20

# ---- Sizing / exposure (dollars) --------------------------------------------
KELLY_FRACTION=0.25
MIN_POSITION_DOLLARS=2.5
MAX_POSITION_DOLLARS=5
MAX_TOTAL_EXPOSURE_DOLLARS=25
MAX_OPEN_POSITIONS=5
MAX_CONTRACTS_PER_ORDER=100

# ---- Exit discipline (cents from entry) -------------------------------------
TAKE_PROFIT_CENTS=10
STOP_LOSS_CENTS=8
# Floor on reward:risk after BOTH fees. 0 = off, which is the default: fees come out of
# the win and are added to the loss, so no dip these profiles accept reaches 1:1 net.
# The dashboard shows the real dollars per position instead.
MIN_REWARD_RISK=0
HOLD_TO_SETTLEMENT_IF_EDGE=true

# ---- Circuit breakers --------------------------------------------------------
DAILY_LOSS_LIMIT_DOLLARS=50
MAX_CONSECUTIVE_LOSSES=5

# ---- Estimators --------------------------------------------------------------
# comma separated, in blend order: manual, microstructure, claude
ESTIMATORS=manual,microstructure
MANUAL_ESTIMATES_PATH=data/estimates.json
# Only needed for ESTIMATORS containing "claude" or `kalshitrader analyze`.
# pip install 'kalshitrader[ai]' and set ANTHROPIC_API_KEY (or use `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# ---- Tracking / dashboard ----------------------------------------------------
DB_PATH=data/kalshitrader.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
LOG_LEVEL=INFO
