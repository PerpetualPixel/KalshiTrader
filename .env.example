# ── Kalshi credentials ────────────────────────────────────────────────
# Which environment to trade against: "demo" or "live"
KALSHI_ENV=demo

# API key ID from https://kalshi.com (Account -> API keys)
KALSHI_KEY_ID=your-kalshi-api-key-id

# Path to the RSA private key .pem you downloaded when creating the key
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private_key.pem

# Optional: separate credentials for live vs demo. If unset, the values
# above are used for whichever environment is active.
# KALSHI_LIVE_KEY_ID=
# KALSHI_LIVE_PRIVATE_KEY_PATH=

# Optional: override the API base URL (defaults are set per-environment
# in src/config.py; only set this if Kalshi moves its API host).
# KALSHI_API_BASE=

# ── Server ────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# SQLite database file for orders / fills / equity history
DATABASE_PATH=./data/kalshitrader.db
